{
  "name": "axon-developer-agent",
  "displayName": "Axon Developer Agent",
  "description": "Run Axon as an AI coding agent in the VS Code sidebar.",
  "version": "0.1.10",
  "publisher": "wanghuimvp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wade-DevCode/axon"
  },
  "license": "MIT",
  "homepage": "https://github.com/Wade-DevCode/axon",
  "bugs": {
    "url": "https://github.com/Wade-DevCode/axon/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#131010",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "axon",
    "vscode",
    "terminal",
    "coding",
    "developer tools"
  ],
  "activationEvents": [
    "onView:axon.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "axon.openSidebar",
        "title": "Axon: Open Sidebar",
        "icon": "$(sparkle)"
      },
      {
        "command": "axon.restartServer",
        "title": "Axon: Restart Local Server",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "axonViewContainer",
          "title": "Axon",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "axonViewContainer": [
        {
          "id": "axon.sidebar",
          "type": "webview",
          "name": "Axon"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "axon.restartServer",
          "when": "view == axon.sidebar",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Axon",
      "properties": {
        "axon.server.command": {
          "type": "string",
          "default": "axon",
          "description": "Axon CLI command or executable path used by the sidebar."
        },
        "axon.server.startupTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "Time in milliseconds to wait for the local Axon server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "build:webview": "bun run ./script/build-webview.ts",
    "compile": "bun run build:webview && bun typecheck && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run build:webview && bun typecheck && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
