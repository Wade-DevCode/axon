#!/usr/bin/env bash
set -euo pipefail

# Get the latest Git tag
latest_tag=$(git tag --sort=committerdate | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)
if [ -z "$latest_tag" ]; then
    echo "No tags found"
    exit 1
fi
echo "Latest tag: $latest_tag"
version=$(echo "$latest_tag" | sed 's/^vscode-v//')
echo "Latest version: $version"

# package-marketplace
package_path="dist/axon-${version}.vsix"
vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o "$package_path" "$version"

# publish-marketplace
vsce publish --packagePath "$package_path"

# publish-openvsx
if [ -n "${OPENVSX_TOKEN:-}" ]; then
    npx ovsx publish "$package_path" -p "$OPENVSX_TOKEN"
else
    echo "OPENVSX_TOKEN is not configured; skipping Open VSX"
fi
