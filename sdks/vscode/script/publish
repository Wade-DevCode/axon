#!/usr/bin/env bash
set -euo pipefail

tag=${GITHUB_REF_NAME:-$(git tag --points-at HEAD | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | head -1)}
if [ -z "$tag" ]; then
    echo "No vscode release tag found at HEAD"
    exit 1
fi
version=${tag#vscode-v}
package_version=$(node -p "require('./package.json').version")
if [ "$version" != "$package_version" ]; then
    echo "Tag version $version does not match package version $package_version"
    exit 1
fi
echo "Publishing version: $version"

# package-marketplace
package_path="dist/axon-${version}.vsix"
vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o "$package_path" "$version"

# publish-marketplace
vsce publish --packagePath "$package_path"

# publish-openvsx
if [ -n "${OPENVSX_TOKEN:-}" ]; then
    npx ovsx publish "$package_path" -p "$OPENVSX_TOKEN"
else
    echo "OPENVSX_TOKEN is not configured; skipping Open VSX"
fi
