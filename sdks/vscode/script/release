#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
version=$(node -p "require('$repo/package.json').version")
tag="vscode-v$version"

if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
  echo "Commit local changes before releasing VS Code." >&2
  exit 1
fi

branch=$(git -C "$repo" branch --show-current)
if [[ "$branch" != "main" ]]; then
  echo "VS Code releases must be created from main, not $branch." >&2
  exit 1
fi

git -C "$repo" fetch origin main --tags
if git -C "$repo" rev-parse "$tag" >/dev/null 2>&1; then
  echo "Tag already exists: $tag" >&2
  exit 1
fi

local_sha=$(git -C "$repo" rev-parse HEAD)
remote_sha=$(git -C "$repo" rev-parse origin/main)
if [[ "$local_sha" != "$remote_sha" ]]; then
  echo "Push main before releasing VS Code." >&2
  exit 1
fi

git -C "$repo" tag "$tag"
git -C "$repo" push origin "$tag"
echo "Pushed $tag. Monitor release-vscode.yml in GitHub Actions."
